# Public site URL (used for canonical tags, sitemap.xml, robots.txt, and JSON-LD)
# Replace with your Cloudflare Pages URL (*.pages.dev) or custom domain once live
NEXT_PUBLIC_SITE_URL=https://altstack.pages.dev

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# Leave blank during development to display styled AdSense placement previews
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
